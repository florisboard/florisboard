    <keys>
        <import base="cldr" path="45/keys-Zyyy-punctuation.xml" />
        <import base="cldr" path="45/keys-Zyyy-currency.xml" />

        <key id="base" layerId="base" width="1.5" />
        <key id="base-to-shift" layerId="shift" width="1.5" />
        <key id="shift-to-base" layerId="base" width="1.5" />
        <key id="numeric" layerId="numeric" />
        <key id="symbol-1" layerId="symbol-1" width="1.5" />
        <key id="symbol-1-fit" layerId="symbol-1" />
        <key id="symbol-2" layerId="symbol-2" width="1.5" />
        <key id="kana" layerId="kana" width="1.5" />
        <key id="kana-base" layerId="base" width="1.5" />

        <key id="bksp" output="@k3:action/backspace" stretch="true" />
        <key id="enter" output="@k3:action/enter" width="1.6" />
        <key id="space-no-stretch" output="\u{0020}" />
        <key id="bksp-no-stretch" output="@k3:action/backspace" />

