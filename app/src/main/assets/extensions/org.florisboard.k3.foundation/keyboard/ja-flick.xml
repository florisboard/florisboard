    <keys>
        <import base="cldr" path="45/keys-Zyyy-punctuation.xml" />
        <import base="cldr" path="45/keys-Zyyy-currency.xml" />

        <key id="shift" layerId="shift" width="1.5" />
        <key id="numeric" layerId="numeric" />
        <key id="symbol-1" layerId="symbol-1" width="1.5" />
        <key id="symbol-2" layerId="symbol-2" width="1.5" />
        <key id="base" layerId="base" width="1.5" />
        <key id="alpha" layerId="alpha" width="3" />
        <key id="alpha-base" layerId="base" width="3" />
        <key id="alpha-shift-base" layerId="alpha" width="1.5" />

        <key id="bksp" output="@k3:action/backspace" width="3" />
        <key id="extra" gap="true" width="3" />
        <key id="enter" output="@k3:action/enter" width="3" />
        <key id="space-no-stretch" output="\u{0020}" />
        <key id="left-arrow" output="@fl:action/arrow_left" width="3" />
        <key id="right-arrow" output="@fl:action/arrow_right" width="3" />

        <!-- Numbers -->
        <key id="0" output="0" />
        <key id="1" output="1" />
        <key id="2" output="2" />
        <key id="3" output="3" />
        <key id="4" output="4" />
        <key id="5" output="5" />
        <key id="6" output="6" />
        <key id="7" output="7" />
        <key id="8" output="8" />
        <key id="9" output="9" />

        <key id="ja-a" output="1" width="3" flickId="ja-a-flick" />
        <key id="ja-i" output="_" width="3" />
        <key id="ja-u" output=";" width="3" />
        <key id="ja-e" output=":" width="3" />
        <key id="ja-o" output="@" width="3" />
        <key id="ja-ka" output="2" width="3" flickId="ja-ka-flick" />
        <key id="ja-ki" output="a" width="3" />
        <key id="ja-ku" output="b" width="3" />
        <key id="ja-ke" output="c" width="3" />
        <key id="ja-ko" output="|" width="3" />
        <key id="ja-sa" output="3" width="3" flickId="ja-sa-flick" />
        <key id="ja-shi" output="d" width="3" />
        <key id="ja-su" output="e" width="3" />
        <key id="ja-se" output="f" width="3" />
        <key id="ja-so" output="~" width="3" />
        <key id="ja-ta" output="4" width="3" flickId="ja-ta-flick" />
        <key id="ja-chi" output="g" width="3" />
        <key id="ja-tsu" output="h" width="3" />
        <key id="ja-te" output="i" width="3" />
        <key id="ja-to" output="$" width="3" />
        <key id="ja-na" output="5" width="3" flickId="ja-na-flick" />
        <key id="ja-ni" output="j" width="3" />
        <key id="ja-nu" output="k" width="3" />
        <key id="ja-ne" output="l" width="3" />
        <key id="ja-no" output="%" width="3" />
        <key id="ja-ha" output="6" width="3" flickId="ja-ha-flick" />
        <key id="ja-hi" output="m" width="3" />
        <key id="ja-hu" output="n" width="3" />
        <key id="ja-he" output="o" width="3" />
        <key id="ja-ho" output="&amp;" width="3" />
        <key id="ja-ma" output="7" width="3" flickId="ja-ma-flick" />
        <key id="ja-mi" output="p" width="3" />
        <key id="ja-mu" output="q" width="3" />
        <key id="ja-me" output="r" width="3" />
        <key id="ja-mo" output="s" width="3" />
        <key id="ja-ya" output="8" width="3" flickId="ja-ya-flick" />
        <key id="ja-yu" output="u" width="3" />
        <key id="ja-yo" output="^" width="3" />
        <key id="ja-ra" output="9" width="3" flickId="ja-ra-flick" />
        <key id="ja-ri" output="w" width="3" />
        <key id="ja-ru" output="x" width="3" />
        <key id="ja-re" output="y" width="3" />
        <key id="ja-ro" output="z" width="3" />
        <key id="ja-wa" output="0" width="3" flickId="ja-wa-flick" />
        <key id="ja-wo" output="+" width="3" />
        <key id="ja-n" output="/" width="3" />
        <key id="ja-long-vowel" output="-" width="3" />
        <key id="ja-daku" output="[" width="3" />
        <key id="ja-daku-root" output="*" width="3" flickId="ja-dakuten-flick" />
        <key id="ja-hand" output="]" width="3" />
        <key id="ja-small" output="`" width="3" />

        <!-- numeric layout keys -->
        <key id="plus-numeric" output="+" width="1.8" longPressKeyIds="hyphen asterisk slash" />
        <key id="open-paren-numeric" output="(" width="1.8" longPressKeyIds="open-square open-curly" />
        <key id="close-paren-numeric" output=")" width="1.8"
            longPressKeyIds="close-square close-curly" />
        <key id="percent-numeric" output="%" width="1.8" />
        <key id="space-numeric" output="\u{0020}" width="1.8" />
        <key id="bksp-numeric" output="@k3:action/backspace" width="1.8" />
        <key id="base-numeric" layerId="base" width="1.8" />
        <key id="comma-numeric" output="," width="1.1" />
        <key id="symbols-numeric" layerId="symbol-1" width="1.9" />
        <key id="equal-numeric" output="=" width="1.9" />
        <key id="period-numeric" output="." width="1.1" />
        <key id="enter-numeric" output="@k3:action/enter" width="1.8" />
        <key id="0-numeric" width="3" output="0" />
        <key id="1-numeric" width="3" output="1" />
        <key id="2-numeric" width="3" output="2" />
        <key id="3-numeric" width="3" output="3" />
        <key id="4-numeric" width="3" output="4" />
        <key id="5-numeric" width="3" output="5" />
        <key id="6-numeric" width="3" output="6" />
        <key id="7-numeric" width="3" output="7" />
        <key id="8-numeric" width="3" output="8" />
        <key id="9-numeric" width="3" output="9" />
    </keys>

    <flicks>
        <flick id="ja-a-flick">
            <flickSegment directions="w" keyId="ja-i" />
            <flickSegment directions="n" keyId="ja-u" />
            <flickSegment directions="e" keyId="ja-e" />
            <flickSegment directions="s" keyId="ja-o" />
        </flick>
        <flick id="ja-ka-flick">
            <flickSegment directions="w" keyId="ja-ki" />
            <flickSegment directions="n" keyId="ja-ku" />
            <flickSegment directions="e" keyId="ja-ke" />
            <flickSegment directions="s" keyId="ja-ko" />
        </flick>
        <flick id="ja-sa-flick">
            <flickSegment directions="w" keyId="ja-shi" />
            <flickSegment directions="n" keyId="ja-su" />
            <flickSegment directions="e" keyId="ja-se" />
            <flickSegment directions="s" keyId="ja-so" />
        </flick>
        <flick id="ja-ta-flick">
            <flickSegment directions="w" keyId="ja-chi" />
            <flickSegment directions="n" keyId="ja-tsu" />
            <flickSegment directions="e" keyId="ja-te" />
            <flickSegment directions="s" keyId="ja-to" />
        </flick>
        <flick id="ja-na-flick">
            <flickSegment directions="w" keyId="ja-ni" />
            <flickSegment directions="n" keyId="ja-nu" />
            <flickSegment directions="e" keyId="ja-ne" />
            <flickSegment directions="s" keyId="ja-no" />
        </flick>
        <flick id="ja-ha-flick">
            <flickSegment directions="w" keyId="ja-hi" />
            <flickSegment directions="n" keyId="ja-hu" />
            <flickSegment directions="e" keyId="ja-he" />
            <flickSegment directions="s" keyId="ja-ho" />
        </flick>
        <flick id="ja-ma-flick">
            <flickSegment directions="w" keyId="ja-mi" />
            <flickSegment directions="n" keyId="ja-mu" />
            <flickSegment directions="e" keyId="ja-me" />
            <flickSegment directions="s" keyId="ja-mo" />
        </flick>
        <flick id="ja-ya-flick">
            <flickSegment directions="w" keyId="open-paren" />
            <flickSegment directions="n" keyId="ja-yu" />
            <flickSegment directions="e" keyId="close-paren" />
            <flickSegment directions="s" keyId="ja-yo" />
        </flick>
        <flick id="ja-ra-flick">
            <flickSegment directions="w" keyId="ja-ri" />
            <flickSegment directions="n" keyId="ja-ru" />
            <flickSegment directions="e" keyId="ja-re" />
            <flickSegment directions="s" keyId="ja-ro" />
        </flick>
        <flick id="ja-dakuten-flick">
            <flickSegment directions="w" keyId="ja-daku" />
            <flickSegment directions="n" keyId="ja-small" />
            <flickSegment directions="e" keyId="ja-hand" />
        </flick>
        <flick id="ja-wa-flick">
            <flickSegment directions="w" keyId="ja-wo" />
            <flickSegment directions="n" keyId="ja-n" />
<!--            <flickSegment directions="e" keyId="ja-e" />-->
<!--            <flickSegment directions="s" keyId="ja-o" />-->
        </flick>
<!--        <flick id="ja-a-flick">-->
<!--            <flickSegment directions="w" keyId="ja-i" />-->
<!--            <flickSegment directions="n" keyId="ja-u" />-->
<!--            <flickSegment directions="e" keyId="ja-e" />-->
<!--            <flickSegment directions="s" keyId="ja-o" />-->
<!--        </flick>-->
    </flicks>

